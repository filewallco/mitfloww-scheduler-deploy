{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/live",
      "destination": "/api/index"
    },
    {
      "source": "/ready",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
