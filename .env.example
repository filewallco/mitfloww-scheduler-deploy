# ==============================================================================
# MitFloww Scheduler - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database Connectivity (PostgreSQL)
DATABASE_URL=postgresql://postgres:pw@127.0.0.1:5432/mitfloww
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000

# Schema & Audit Table Handling
AUTO_CREATE_AUDIT_TABLE=true
AUDIT_LOG_RETENTION_DAYS=30

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mitfloww-files
ASSETS_BUCKET_NAME=mitfloww-assets
R2_S3_ENDPOINT=
R2_CONNECT_TIMEOUT_MS=10000
R2_REQUEST_TIMEOUT_MS=30000
R2_MAX_ATTEMPTS=3

# Scheduler Master Control
SCHEDULER_ENABLED=true
DRY_RUN=false
LOG_LEVEL=info
SCHEDULER_TICK_INTERVAL_MS=10000
SCHEDULER_BATCH_SIZE=100
SCHEDULER_MAX_CONCURRENCY=3

# Health Server Probe
HEALTH_SERVER_ENABLED=true
HEALTH_SERVER_PORT=4002

# System-Level Retention Periods (Separated from DB business rules)
# Account soft-delete retention before permanent purge (days)
ACCOUNT_DELETION_RETENTION_DAYS=30

# Stale / abandoned upload retention threshold before cleanup (hours)
STALE_UPLOAD_RETENTION_HOURS=24

# Orphaned worker processing artifact retention before cleanup (hours)
ORPHANED_FILE_RETENTION_HOURS=48

# Soft-deleted asset retention before permanent purge (days)
SOFT_DELETED_ASSET_RETENTION_DAYS=14

# Resolved file version report retention (days)
RESOLVED_REPORT_RETENTION_DAYS=30

# Distributed Lock Configuration
LOCK_TTL_MS=60000
